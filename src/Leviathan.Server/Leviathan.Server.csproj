<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Source-workspace integration until the conversation API is published. -->
    <DominatusSourceRoot Condition="'$(DominatusSourceRoot)' == ''">$(MSBuildThisFileDirectory)../../../Dominatus</DominatusSourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Leviathan.Server.Tests" />
    <PackageReference Include="Tomlyn" Version="0.19.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.103.3" />
    <ProjectReference Include="$(DominatusSourceRoot)/src/Dominatus.Core/Dominatus.Core.csproj" />
    <ProjectReference Include="$(DominatusSourceRoot)/src/Dominatus.OptFlow/Dominatus.OptFlow.csproj" />
    <ProjectReference Include="$(DominatusSourceRoot)/src/Ariadne.OptFlow/Ariadne.OptFlow.csproj" />
    <ProjectReference Include="$(DominatusSourceRoot)/src/Dominatus.Llm.OptFlow/Dominatus.Llm.OptFlow.csproj" />
    <!-- Referenced directly: Leviathan uses Dominatus.Llm.Context types, and NuGet restore does not
         reliably flow this transitive project reference from a sibling checkout (CS0234 on a fresh clone). -->
    <ProjectReference Include="$(DominatusSourceRoot)/src/Dominatus.Llm.Context/Dominatus.Llm.Context.csproj" />
    <ProjectReference Include="$(DominatusSourceRoot)/src/Dominatus.Actuators.SemanticKernel/Dominatus.Actuators.SemanticKernel.csproj" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="PdfPig" Version="0.1.13" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Retained legacy sample script only; the runtime and LLM dependencies above
         come from the maintained Dominatus source workspace. -->
    <Compile Include="../../vendor/Dominatus/src/Ariadne.Console/Scripts/RustSimulator.cs" Link="Ariadne/VendoredReference/RustSimulator.cs" />
  </ItemGroup>
  <Target Name="RequireDominatusConversationSource" BeforeTargets="PrepareForBuild"
          Condition="!Exists('$(DominatusSourceRoot)/src/Dominatus.Llm.OptFlow/LlmConversation.cs')">
    <Error Text="Current Dominatus conversation sources are required. Check out the matching Dominatus changes beside Leviathan or set DominatusSourceRoot explicitly; the vendored snapshot is not a fallback runtime." />
  </Target>
</Project>
